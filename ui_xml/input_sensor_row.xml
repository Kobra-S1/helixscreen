<!-- Input Sensor Row Component -->
<!-- One on/off input (door switch, button): name, live state, role, invert -->
<!-- Row data comes from InputSensorManager's input_sensor_*_<index> subjects -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
  </api>
  <view name="input_sensor_row"
        extends="lv_obj" width="100%" height="content" style_bg_opa="0" style_border_width="0"
        style_pad_left="#space_sm" style_pad_right="#space_sm" style_pad_top="#space_md" style_pad_bottom="#space_md"
        scrollable="false" flex_flow="column" style_pad_gap="#space_sm">
    <!-- Top Row: Name + live state -->
    <lv_obj width="100%"
            height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_main_place="space_between"
            style_flex_cross_place="center">
      <lv_obj height="content"
              style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_sm" flex_grow="1">
        <icon src="electric_switch" size="sm" variant="primary"/>
        <text_body name="name_label" bind_text="input_sensor_name_${index}" long_mode="dots" flex_grow="1"/>
      </lv_obj>
      <text_small name="state_label" bind_text="input_sensor_state_${index}">
        <bind_style_if_eq name="styles.chip_text_warning" subject="input_sensor_alert_${index}" ref_value="1"/>
      </text_small>
    </lv_obj>
    <!-- Bottom Row: Role dropdown + Invert toggle -->
    <lv_obj width="100%"
            height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_main_place="space_between"
            style_flex_cross_place="center">
      <lv_obj height="content"
              style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_sm">
        <text_small text="Role:"/>
        <lv_dropdown name="role_dropdown"
                     width="120" height="36" options="Other&#10;Door" options_tag="Other&#10;Door"
                     style_radius="#border_radius" bind_selected="input_sensor_role_${index}">
          <event_cb trigger="value_changed" callback="on_input_sensor_role_changed" user_data="$index"/>
        </lv_dropdown>
      </lv_obj>
      <lv_obj height="content"
              style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_sm">
        <!-- Only a door's open/closed reading depends on which way the switch reads -->
        <bind_flag_if_not_eq subject="input_sensor_role_${index}" flag="hidden" ref_value="1"/>
        <text_small text="Invert"/>
        <ui_switch name="invert_toggle" size="tiny">
          <bind_state_if_eq subject="input_sensor_inverted_${index}" state="checked" ref_value="1"/>
          <event_cb trigger="value_changed" callback="on_input_sensor_invert_changed" user_data="$index"/>
        </ui_switch>
      </lv_obj>
    </lv_obj>
    <divider_horizontal style_margin_top="#space_xs"/>
  </view>
</component>
