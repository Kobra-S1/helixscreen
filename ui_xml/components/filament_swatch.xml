<component>
  <!-- One G-code tool's chip in the Print File Detail FILAMENTS card, bound to
       the filament_chip_<index>_* subjects FilamentMappingCard publishes. The
       card's filament_chip_row repeats it filament_chip_count times.

         - header: filled with the file's colour for the tool (no fill when the
           file names none) and labelled with the file's material, or the
           G-code tool name when the file names no material. _ink picks a text
           colour that reads on the fill.
         - body: the mapped slot's spool (its colour, split and finish), a ring
           for an empty slot, the slot label ("3", "2·1", or "Pick" when no slot
           is chosen) and a caret while a tap can remap. On a printer with no
           filament system (filament_chip_loaded) the body is what is loaded:
           its spool and "Loaded", "?" when nothing says, or "Swap" for a later
           tool, in a smaller font; no caret and no remap. A tap reports the
           chip index through filament_chip_clicked_cb.
         - outline: the one signal. Grey when matched, amber when only the
           colour differs, red when the material differs or the slot is empty or
           missing; the slot text turns red with it. -->
  <api>
    <prop name="index" type="string" default="0"/>
  </api>
  <styles>
    <!-- Inline style attributes outrank bound styles, so every property a
         binding changes starts in a style here instead. -->
    <style name="chip_ok" border_color="#text_muted"/>
    <style name="chip_warn" border_color="#warning"/>
    <style name="chip_block" border_color="#danger"/>
    <style name="theme_ink" text_color="#text"/>
    <style name="slot_block" text_color="#danger"/>
    <style name="slot_number" text_font="#font_small"/>
    <style name="slot_word" text_font="#font_xs"/>
    <style name="ink_dark" text_color="0x000000"/>
    <style name="ink_light" text_color="0xFFFFFF"/>
  </styles>
  <view extends="lv_obj"
        width="#filament_chip_width" height="100%" flex_flow="column" style_pad_all="0" style_pad_row="0"
        style_radius="#space_sm" style_bg_color="#card_bg" style_bg_opa="255" style_border_width="2"
        style_border_post="true" style_clip_corner="true" scrollable="false" clickable="true">
    <style name="chip_ok"/>
    <bind_style_if_eq name="chip_warn" subject="filament_chip_${index}_severity" ref_value="1"/>
    <bind_style_if_eq name="chip_block" subject="filament_chip_${index}_severity" ref_value="2"/>
    <lv_obj name="chip_header"
            width="100%" height="0" flex_grow="2" style_pad_all="0" style_radius="0" style_bg_opa="0"
            style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
      <swatch_paint name="chip_header_fill"
                    width="100%" height="100%" style_radius="0" edge="off"
                    bind_color="filament_chip_${index}_file_color">
        <bind_flag_if_eq subject="filament_chip_${index}_file_color_known" flag="hidden" ref_value="0"/>
      </swatch_paint>
      <lv_label name="chip_material"
                width="100%" align="center" bind_text="filament_chip_${index}_material" long_mode="clip"
                style_text_align="center" style_text_font="#font_xs" clickable="false" event_bubble="true">
        <style name="theme_ink"/>
        <bind_style_if_eq name="ink_dark" subject="filament_chip_${index}_ink" ref_value="1"/>
        <bind_style_if_eq name="ink_light" subject="filament_chip_${index}_ink" ref_value="2"/>
      </lv_label>
    </lv_obj>
    <lv_obj name="chip_body"
            width="100%" height="0" flex_grow="3" flex_flow="row" style_flex_main_place="center"
            style_flex_cross_place="center" style_pad_hor="#space_xxs" style_pad_ver="0" style_pad_gap="#space_xxs"
            style_radius="0" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false"
            event_bubble="true">
      <color_dot name="chip_spool"
                 size="#space_md" color_subject="filament_chip_${index}_slot_color"
                 colors_subject="filament_chip_${index}_slot_colors" finish_subject="filament_chip_${index}_slot_finish">
        <bind_flag_if_not_eq subject="filament_chip_${index}_slot_state" flag="hidden" ref_value="1"/>
      </color_dot>
      <lv_obj name="chip_empty_ring"
              width="#space_md" height="#space_md" style_radius="9999" style_bg_opa="0" style_border_width="2"
              style_border_color="#danger" style_border_opa="255" scrollable="false" clickable="false"
              event_bubble="true">
        <bind_flag_if_not_eq subject="filament_chip_${index}_slot_state" flag="hidden" ref_value="2"/>
      </lv_obj>
      <lv_label name="chip_slot"
                bind_text="filament_chip_${index}_slot" long_mode="clip" clickable="false" event_bubble="true">
        <style name="theme_ink"/>
        <style name="slot_number"/>
        <bind_style_if_eq name="slot_word" subject="filament_chip_loaded" ref_value="1"/>
        <bind_style_if_eq name="slot_block" subject="filament_chip_${index}_severity" ref_value="2"/>
      </lv_label>
      <icon name="chip_caret" src="chevron_down" size="xs" variant="secondary" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="color_card_remappable" flag="hidden" ref_value="0"/>
      </icon>
    </lv_obj>
    <!-- A tap opens this tool's slot dropdown, through the card's remap gate.
         The chip takes the tap itself rather than bubbling it to the card. -->
    <event_cb trigger="clicked" callback="filament_chip_clicked_cb" user_data="$index"/>
  </view>
</component>
