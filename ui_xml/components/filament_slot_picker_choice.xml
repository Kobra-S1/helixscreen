<component>
  <!-- A filament slot picker row that names no slot (Auto, the extra answer,
       Cancel): the same look as filament_slot_picker_row with only its text.
       A tap reports $choice through filament_picker_row_cb. -->
  <api>
    <prop name="choice" type="string" default=""/>
    <prop name="text_subject" type="string" default=""/>
    <!-- 1 rings the row as the current answer; empty for a row that never is. -->
    <prop name="selected_subject" type="string" default=""/>
  </api>
  <styles>
    <style name="row_selected" bg_color="#primary" bg_opa="40" border_width="1" border_color="#primary"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="#space_md"
        style_pad_gap="#space_md" style_radius="#space_sm" style_border_width="0" style_bg_opa="0" scrollable="false"
        clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <bind_style_if_eq name="row_selected" subject="$selected_subject" ref_value="1"/>
    <text_body name="slot_label"
               flex_grow="1" bind_text="$text_subject" long_mode="dots" clickable="false" event_bubble="true"/>
    <event_cb trigger="clicked" callback="filament_picker_row_cb" user_data="$choice"/>
  </view>
</component>
